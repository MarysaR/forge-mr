# Fichier généré par le rôle shell de ForgeMR : toute modification manuelle sera écrasée
# à la prochaine exécution du rôle.

{% if 'fd' in shell_tools %}
# Le paquet apt de fd (fd-find) installe le binaire sous le nom fdfind ; cet alias restaure le nom attendu.
alias fd='fdfind'
{% endif %}

{% if 'bat' in shell_tools %}
# Le paquet apt de bat installe le binaire sous le nom batcat ; cet alias restaure le nom attendu.
alias bat='batcat'
{% endif %}
