# Fichier généré par le rôle shell de ForgeMR : toute modification manuelle sera écrasée
# à la prochaine exécution du rôle.

{% if shell_install_oh_my_zsh %}
# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="{{ shell_oh_my_zsh_theme }}"
plugins=(
{% for plugin in shell_plugins %}
  {{ plugin }}
{% endfor %}
)
source $ZSH/oh-my-zsh.sh
{% endif %}

# ForgeMR aliases
source "$HOME/.config/zsh/aliases.zsh"

{% if shell_install_mise %}
# Runtime manager
eval "$(mise activate zsh)"
{% endif %}
